{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ["./.opencode/plugins/project-context.ts", {
      "enabled": true,
      "maxProjectMemoryTokens": 1500,
      "maxSessionHandoffTokens": 1000,
      "maxToolResultLines": 100,
      "maxDiffLines": 120,
